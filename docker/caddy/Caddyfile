# Mesma origem para UI e API (cookie de refresh SameSite=Strict sem CORS). Actuator (9090) NÃO é exposto.
{$ACHERNAR_PUBLIC_HOST} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	@api path /auth/* /api/* /setup/* /.well-known/*
	handle @api {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy ui:8080
	}
}
