# Copie para docker/.env (NUNCA versionar o .env). Valores *_FILE são aceitos para segredos (ver parameters.md).

# --- Desenvolvimento (docker-compose.yml) ---
POSTGRES_DB=achernar_identity
POSTGRES_USER=achernar_identity
POSTGRES_PASSWORD=achernar_identity
POSTGRES_PORT=5432
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

# --- Banco (produção: docker-compose.prod.yml) ---
ACHERNAR_DB_PASSWORD=troque-esta-senha

# --- Identity (produção) ---
# URL pública única (mesma origem para UI e API; ver docker/caddy/Caddyfile)
ACHERNAR_PUBLIC_HOST=identity.exemplo.com
ACHERNAR_ISSUER=https://identity.exemplo.com
ACHERNAR_UI_BASE_URL=https://identity.exemplo.com
ACHERNAR_UI_ORIGINS=https://identity.exemplo.com
# 32 bytes aleatórios em base64:  openssl rand -base64 32
ACHERNAR_MASTER_KEY=
# Token de uso único para criar o primeiro administrador (>= 32 caracteres); remova após o setup
ACHERNAR_BOOTSTRAP_TOKEN=
# CIDRs/IPs dos proxies confiáveis (o Caddy do compose) para extrair o IP real
ACHERNAR_TRUSTED_PROXIES=172.16.0.0/12

# --- SMTP ---
ACHERNAR_SMTP_HOST=smtp.exemplo.com
ACHERNAR_SMTP_PORT=587
ACHERNAR_SMTP_USERNAME=
ACHERNAR_SMTP_PASSWORD=
ACHERNAR_SMTP_AUTH=true
ACHERNAR_SMTP_STARTTLS=true
ACHERNAR_MAIL_FROM=no-reply@exemplo.com

# --- Login social (opcional; vazio = provedor desabilitado) ---
ACHERNAR_GOOGLE_CLIENT_ID=
ACHERNAR_GOOGLE_CLIENT_SECRET=
ACHERNAR_FACEBOOK_APP_ID=
ACHERNAR_FACEBOOK_APP_SECRET=
